# voice-agent — Environment Variables
# Copy this file to .env and fill in your API keys.
# Nested settings use "__": LLM__PROVIDER, STT__MODEL, TTS__VOICE ...

# Daily (transport)
DAILY_API_KEY=
# DAILY_ROOM_URL=

# API keys (provider-conventional names; LLM__API_KEY etc. also work)
GROQ_API_KEY=
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=          # only used when TTS__PROVIDER=cartesia
# GOOGLE_API_KEY=             # gemini
# DEEPGRAM_API_KEY=
# BASETEN_API_KEY=
# OPENAI_API_KEY=

# LLM — default: groq
# Providers: baseten | openai | gemini | groq  (see services/llm/factory.py for default models)
# LLM__PROVIDER=gemini
# LLM__MODEL=
# LLM__API_KEY=
# Optional fallback LLM (enables LLMSwitcher)
# LLM_FALLBACK__PROVIDER=openai
# LLM_FALLBACK__MODEL=

# STT — default: groq / vi
# Providers: deepgram | gemini | groq | cartesia  (see services/stt/factory.py for default models)
# STT__PROVIDER=deepgram
# STT__MODEL=
# STT__BASE_URL=               # groq only
# STT__LANGUAGE=vi

# TTS — default: cartesia / vi
# Providers: cartesia | gemini (Vietnamese) | deepgram | groq (English only)
# TTS__PROVIDER=gemini
# TTS__MODEL=
# TTS__VOICE=                  # provider voice id; empty = factory default
# TTS__LANGUAGE=vi

# Turn-taking preset: webrtc | telephony | kiosk | intake  (see config/profiles.py)
# TURN_PROFILE=webrtc
# LOG_LEVEL=DEBUG
