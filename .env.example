# voice-agent — Environment Variables
# Copy this file to .env and fill in your API keys.
# All settings are flat env vars: LLM_PROVIDER, STT_MODEL, TTS_VOICE ...

# Daily (transport)
DAILY_API_KEY=
# DAILY_ROOM_URL=

# API keys (provider-conventional names; LLM_API_KEY etc. also work)
GROQ_API_KEY=
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=          # only used when TTS_PROVIDER=cartesia
# GOOGLE_API_KEY=             # gemini
# DEEPGRAM_API_KEY=
# BASETEN_API_KEY=
# OPENAI_API_KEY=
# VLLM_API_KEY=EMPTY          # self-hosted vLLM; "EMPTY" is vLLM's own placeholder for "no auth required"

# LLM — default: groq
# Providers: baseten | openai | gemini | groq  (see config/defaults.py for default models)
# LLM_PROVIDER=gemini
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024
# Optional fallback LLM (enables LLMSwitcher)
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=

# STT — default: cartesia / vi
# Providers: deepgram | gemini | groq | cartesia | vllm | vllm_realtime  (see config/defaults.py)
# STT_PROVIDER=vllm
# STT_MODEL=                   # e.g. Qwen/Qwen3-ASR-1.7B for vllm
# STT_BASE_URL=                # groq / vllm / vllm_realtime (ws://<host>:8000/v1/realtime)
# STT_LANGUAGE=vi

# TTS — default: cartesia / vi
# Providers: cartesia | gemini (Vietnamese) | deepgram | groq (English only)
# TTS_PROVIDER=gemini
# TTS_MODEL=
# TTS_VOICE=                   # provider voice id; empty = factory default
# TTS_LANGUAGE=vi

# Turn-taking preset: webrtc | telephony | kiosk | intake  (see config/profiles.py)
# TURN_PROFILE=webrtc
# LOG_LEVEL=DEBUG
