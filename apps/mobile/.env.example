# Copy thành .env (không commit). Biến EXPO_PUBLIC_* được nhúng vào app lúc
# Metro bundle — sửa xong phải khởi động lại `npx expo start`.

# Địa chỉ bot (HTTPS). Qua Tailscale: `tailscale serve --bg --https=8443 http://127.0.0.1:7860`
EXPO_PUBLIC_BOT_URL=https://<pc>.<tailnet>.ts.net:8443

# Gửi header X-App-Key kèm /start và offer. Để trống khi dùng Tailscale.
EXPO_PUBLIC_APP_KEY=

# Transport đã đăng ký trong src/lib/transports.ts. Hiện chỉ có smallwebrtc.
EXPO_PUBLIC_TRANSPORT=smallwebrtc

# Dự phòng: ghi đè iceConfig mà bot trả về từ /start. Bình thường để trống —
# cấu hình ICE/TURN ở PIPECAT_ICE_SERVERS phía bot.
# Nhận danh sách URL cách nhau bằng dấu phẩy, hoặc mảng JSON:
# EXPO_PUBLIC_ICE_SERVERS='[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]'
EXPO_PUBLIC_ICE_SERVERS=
